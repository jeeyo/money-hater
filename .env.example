# --- Database ---
DATABASE_URL=postgresql+asyncpg://moneyhater:moneyhater@localhost:5432/moneyhater
# Procrastinate connects with psycopg (sync URL, no driver suffix)
QUEUE_DATABASE_URL=postgresql://moneyhater:moneyhater@localhost:5432/moneyhater

# --- Auth ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# --- Media storage (a PVC mount in Kubernetes) ---
MEDIA_ROOT=./data/media

# --- OpenAI (optional; degrades gracefully without it) ---
# Powers two things: reading your photos, and suggesting where to go next.
# The model must be able to see images and to use the hosted web search tool,
# which is why this is OpenAI rather than any provider you like.
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Optional: overrides OPENAI_API_KEY above when you want an explicit key.
LLM_API_KEY=
# How long one photo's model call may take before the pipeline logs the photo
# without a caption and moves on. The SDK's own default is ten minutes and it
# retries on top of that, which is long enough that a photo looks stuck.
VISION_TIMEOUT_SECONDS=120

# --- Places (optional) ---
# Google: reverse geocoding, Places resolution, and the candidates the
# recommender chooses between. Suggestions need this as well as an OpenAI key.
GOOGLE_MAPS_API_KEY=

# --- Next-stop recommendations ---
# How long a generated set stays fresh (arriving somewhere new also expires it)
RECOMMENDATION_TTL_MINUTES=90
# Cost guard, per user per day; 0 = unlimited
DAILY_RECOMMENDATION_CAP=50

# --- Currency ---
# Foreign spend is converted into each user's base currency (THB by default,
# changeable in Settings) using ECB reference rates via Frankfurter — no API
# key. Leave blank to disable lookups; foreign expenses then wait for a rate
# entered by hand.
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1/latest

# --- Limits ---
# Max analyzed images per user per day (cost guard); 0 = unlimited
DAILY_ANALYSIS_CAP=200
MAX_UPLOAD_BYTES=26214400
