# --- Database ---
DATABASE_URL=postgresql+asyncpg://moneyhater:moneyhater@localhost:5432/moneyhater
# Procrastinate connects with psycopg (sync URL, no driver suffix)
QUEUE_DATABASE_URL=postgresql://moneyhater:moneyhater@localhost:5432/moneyhater

# --- Auth ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# --- Media storage (a PVC mount in Kubernetes) ---
MEDIA_ROOT=./data/media

# --- Image understanding (optional; degrades gracefully without it) ---
# Any vision model LiteLLM supports, named provider/model. Examples:
#   openai/gpt-4.1-mini            anthropic/claude-sonnet-4-5
#   gemini/gemini-2.5-flash        groq/llama-3.2-90b-vision-preview
#   ollama/llava                   hosted_vllm/Qwen2-VL-7B-Instruct
LLM_MODEL=openai/gpt-4.1-mini
# Leave blank to let LiteLLM read the provider's own variable below.
LLM_API_KEY=
# Optional: a LiteLLM proxy, an Ollama host, or any OpenAI-compatible server.
# LLM_API_BASE=http://localhost:11434
# Whichever provider you chose (LiteLLM reads these directly):
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Places (optional) ---
# Google: reverse geocoding + Places resolution
GOOGLE_MAPS_API_KEY=

# --- Currency ---
# Foreign spend is converted into each user's base currency (THB by default,
# changeable in Settings) using ECB reference rates via Frankfurter — no API
# key. Leave blank to disable lookups; foreign expenses then wait for a rate
# entered by hand.
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1/latest

# --- Limits ---
# Max analyzed images per user per day (cost guard); 0 = unlimited
DAILY_ANALYSIS_CAP=200
MAX_UPLOAD_BYTES=26214400
