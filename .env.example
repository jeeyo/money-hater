# --- Database ---
DATABASE_URL=postgresql+asyncpg://moneyhater:moneyhater@localhost:5432/moneyhater
# Procrastinate connects with psycopg (sync URL, no driver suffix)
QUEUE_DATABASE_URL=postgresql://moneyhater:moneyhater@localhost:5432/moneyhater

# --- Auth ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# --- Media storage (a PVC mount in Kubernetes) ---
MEDIA_ROOT=./data/media

# --- External APIs (both optional; features degrade gracefully without them) ---
# OpenAI: vision classification + receipt parsing via the Agents SDK
OPENAI_API_KEY=
# Model used for image analysis
OPENAI_VISION_MODEL=gpt-4.1-mini
# Google: reverse geocoding + Places resolution
GOOGLE_MAPS_API_KEY=

# --- Currency ---
# Foreign spend is converted into each user's base currency (THB by default,
# changeable in Settings) using ECB reference rates via Frankfurter — no API
# key. Leave blank to disable lookups; foreign expenses then wait for a rate
# entered by hand.
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1/latest

# --- Limits ---
# Max analyzed images per user per day (cost guard); 0 = unlimited
DAILY_ANALYSIS_CAP=200
MAX_UPLOAD_BYTES=26214400
