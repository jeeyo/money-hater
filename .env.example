# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Database URL for Prisma (local development)
DATABASE_URL="file:./dev.db"

# JWT Secret (generate with: openssl rand -base64 32)
# This is used for signing JWT tokens
# In production, set this via: npx wrangler secret put JWT_SECRET
JWT_SECRET="your-secret-key-change-in-production-use-env-var"

# Cloudflare Account ID (for local development with wrangler)
# Get from: https://dash.cloudflare.com/
# CLOUDFLARE_ACCOUNT_ID="your-account-id-here"

# Cloudflare API Token (for local development with wrangler)
# Get from: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN="your-api-token-here"

GEMINI_API_KEY="your-gemini-api-key-here"
RESEND_API_KEY="your-resend-api-key-here"

# LiteLLM proxy (OpenAI-compatible /chat/completions). Powers the agentic
# classifier and the chat assistant. In production set the key via:
#   npx wrangler secret put LITELLM_API_KEY
LITELLM_BASE_URL="https://your-litellm-proxy.example.com"
LITELLM_API_KEY="your-litellm-key-here"
LITELLM_MODEL="gpt-4o-mini"

# Google Maps Platform key (server-side only — never expose to the browser).
# Used by the resolve_place agent tool. Enable the Places API (New) + Geocoding.
GOOGLE_MAPS_API_KEY="your-google-maps-key-here"

# Web search provider for the web_search agent tool. Pluggable via URL + key
# (Tavily by default; Serper/Brave differ only in request/response shape).
SEARCH_API_URL="https://api.tavily.com/search"
SEARCH_API_KEY="your-search-api-key-here"
