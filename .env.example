# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Database URL for Prisma (local development)
DATABASE_URL="file:./dev.db"

# JWT Secret (generate with: openssl rand -base64 32)
# This is used for signing JWT tokens
# In production, set this via: npx wrangler secret put JWT_SECRET
JWT_SECRET="your-secret-key-change-in-production-use-env-var"

# Cloudflare Account ID (for local development with wrangler)
# Get from: https://dash.cloudflare.com/
# CLOUDFLARE_ACCOUNT_ID="your-account-id-here"

# Cloudflare API Token (for local development with wrangler)
# Get from: https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN="your-api-token-here"

GEMINI_API_KEY="your-gemini-api-key-here"
RESEND_API_KEY="your-resend-api-key-here"
